# Open Accounting API Configuration
# Copy this file to .env and customize as needed
# Required variables are marked with (REQUIRED)

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string (REQUIRED)
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5432/open_accounting?sslmode=disable

# =============================================================================
# SERVER
# =============================================================================

# HTTP server port (default: 8080)
PORT=8080

# Log level: trace, debug, info, warn, error, fatal, panic (default: info)
LOG_LEVEL=info

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT signing secret (REQUIRED for production)
# Generate with: openssl rand -base64 32
# WARNING: Default is insecure - always set in production!
JWT_SECRET=your-secure-secret-here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins
# Default: http://localhost:5173,http://localhost:3000
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Enable CORS debug logging (default: false)
# Set to "true" to enable
CORS_DEBUG=false

# =============================================================================
# SCHEDULER
# =============================================================================

# Enable recurring invoice scheduler (default: true)
# Set to "false" to disable
SCHEDULER_ENABLED=true

# Cron schedule for recurring invoice generation
# Default: "0 6 * * *" (6 AM daily)
# RECURRING_INVOICE_SCHEDULE=0 6 * * *

# Cron schedule for recurring journal entry generation
# Default: "15 6 * * *" (6:15 AM daily)
# RECURRING_JOURNAL_ENTRY_SCHEDULE=15 6 * * *

# Cron schedule for document retention reminder delivery
# Default: "30 9 * * *" (9:30 AM daily)
# DOCUMENT_RETENTION_REMINDER_SCHEDULE=30 9 * * *

# Retention reminder lookahead horizon in days
DOCUMENT_RETENTION_REMINDER_HORIZON_DAYS=30

# Include documents missing retention metadata in scheduled reminder digests
DOCUMENT_RETENTION_REMINDER_INCLUDE_MISSING=true

# Retry failed document retention reminder delivery attempts before reporting failure
DOCUMENT_RETENTION_REMINDER_MAX_ATTEMPTS=3

# Mark failed document retention reminder delivery as escalated after this many attempts
DOCUMENT_RETENTION_REMINDER_ESCALATE_AFTER_ATTEMPTS=3

# =============================================================================
# DEMO MODE (Optional)
# =============================================================================

# Enable demo reset endpoint (default: false)
# Only enable in demo/staging environments, never in production!
DEMO_MODE=false

# Secret key for demo reset endpoint (required if DEMO_MODE=true)
# DEMO_RESET_SECRET=your-demo-secret-here
