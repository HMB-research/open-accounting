# Tailscale-only Open Accounting deployment for server-nuc.
# Copy this file to .env on the server and replace the two secrets.
BIND_ADDRESS=100.127.112.124
PUBLIC_HOSTNAME=server-nuc
FRONTEND_PORT=3000
API_PORT=8082

DB_USER=openaccounting
DB_NAME=openaccounting
DB_PASSWORD=replace-with-a-random-hex-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://server-nuc:3000,http://server-nuc.tempel-adelie.ts.net:3000
BACKUP_RETENTION_DAYS=30
